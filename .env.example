# =========================================================
# SRI SAI SIRI BOYS HOSTEL - ENVIRONMENT CONFIGURATION (.env)
# =========================================================

# Database Connection (MySQL Production Database)
# Format: mysql://DB_USER:DB_PASSWORD@DB_HOST:DB_PORT/DB_NAME?sslmode=require&connection_limit=10
DATABASE_URL="mysql://srisiri_admin:StrongPassword123!@mysql-host.example.com:3306/srisaisiri_db?sslmode=require&connection_limit=10"

# Granular MySQL Parameters (for MySQL Workbench & custom scripts)
DB_HOST="mysql-host.example.com"
DB_PORT="3306"
DB_NAME="srisaisiri_db"
DB_USER="srisiri_admin"
DB_PASSWORD="StrongPassword123!"

# Application Secret Key for JWT & Session Encryption
AUTH_SECRET="super-secret-jwt-key-sri-sai-siri-2026-production"
NEXTAUTH_SECRET="super-secret-jwt-key-sri-sai-siri-2026-production"

# Application Base URL
NEXT_PUBLIC_API_URL="https://srisaisiri.vercel.app"
NODE_ENV="production"
